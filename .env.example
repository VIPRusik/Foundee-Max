# Токен бота MAX (выдаётся организаторами / на платформе MAX для партнёров). Обязателен.
BOT_TOKEN=your_bot_token_here

# Адрес мини-приложения (HTTPS). По умолчанию — развёрнутая версия на Vercel.
MINIAPP_URL=https://max-miniapp-eight.vercel.app/

# Необязательные параметры (значения по умолчанию указаны ниже)
# CA_CERT_PATH=certs/russian_trusted_bundle.pem
# DATA_DIR=data
