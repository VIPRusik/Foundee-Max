# Используем легковесный образ Node.js
FROM node:20-alpine

# Устанавливаем рабочую директорию
WORKDIR /app

# Сначала копируем только файлы зависимостей, чтобы использовать кэш Docker
COPY package*.json ./

# Устанавливаем зависимости (используем npm ci для чистой установки по package-lock.json)
RUN npm ci --only=production

# Копируем весь остальной код проекта
COPY . .

# Открываем порт, если ваше приложение слушает какой-то порт (например, для вебхуков или мини-аппа)
# Если бот работает только через Long Polling, порт можно не открывать.
# Но для мини-аппа он обычно нужен.
EXPOSE 3000

# Команда для запуска бота
CMD ["node", "bot.js"]